# Path to the actual CSV on your Windows PC
STUDENT_CSV_PATH=C:\Users\V SRI KARTIKEYA\student-performance\student_performance.csv

# AWS S3 (leave S3_BUCKET empty until your bucket is ready)
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET=
S3_RAW_KEY=raw/student_performance.csv
S3_RESULT_KEY=results/average/part-m-00000

# Existing Windows Hadoop 3.3.6 installation
HADOOP_HOME=C:\hadoop\hadoop-3.3.6\hadoop-3.3.6
HADOOP_CMD=C:\hadoop\hadoop-3.3.6\hadoop-3.3.6\bin\hadoop.cmd
HADOOP_JAR=C:\Users\V SRI KARTIKEYA\student-performance\AverageExam.jar
HADOOP_MAIN_CLASS=AverageExam
HDFS_INPUT=/student/input/student_performance.csv
HDFS_OUTPUT=/student/output/average

FRONTEND_ORIGIN=http://localhost:5173
API_PORT=5000
